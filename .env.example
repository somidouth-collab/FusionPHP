# Copy to .env. Process environment variables take precedence.
APP_NAME=FusionPHP
APP_URL=http://localhost:8000
APP_VERSION=1.0.0
APP_MODE=both
APP_BASE_PATH=
FUSIONPHP_DEBUG=false

API_PREFIX=/api
API_SESSION=false
# Optional application values. These alone do not enable authentication.
API_KEY=
API_BASE_URL=

DB_DRIVER=sqlite
DB_PATH=storage/database.sqlite
DB_HOST=127.0.0.1
# Leave blank for the default port of the selected driver.
DB_PORT=
DB_NAME=fusionphp
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=fusion_session
SESSION_LIFETIME=0

# Optional application settings for a mail integration.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@fusionphp.com
