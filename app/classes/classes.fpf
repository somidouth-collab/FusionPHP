<header class="page-header">
<h1>{{ title }}</h1>
<p>Browse the framework and starter application classes. Each entry lists the public and protected members declared on that class. Follow the parent link for inherited members.</p>
</header>
<nav class="class-index card card-body" aria-label="Class index">
    {% for group in groups %}
    <h2>{{ group.title }}</h2>
    <ul class="list-group">
        {% for class in group.classes %}
        <li class="list-group-item"><a href="{{ url class.anchor }}">{{ class.shortName }}</a></li>
        {% endfor %}
    </ul>
    {% endfor %}
</nav>
{% for group in groups %}
<section>
    <h2>{{ group.title }}</h2>
    {% for class in group.classes %}
    <article class="class-entry" id="{{ class.id }}">
        <h3>{{ class.shortName }}</h3>
        <p><code>{{ class.declaration }}</code></p>
        {% if class.parent %}
        <p>Extends
            {% if class.parentAnchor %}
            <a href="{{ url class.parentAnchor }}"><code>{{ class.parent }}</code></a>
            {% else %}
            <code>{{ class.parent }}</code>
            {% endif %}
        </p>
        {% endif %}
        <p>{{ class.summary }}</p>
        {% if class.properties %}
        <h4>Properties</h4>
        <dl>
            {% for property in class.properties %}
            <dt><code>{{ property.signature }}</code></dt>
            <dd>{{ property.description }}</dd>
            {% endfor %}
        </dl>
        {% endif %}
        {% if class.methods %}
        <h4>Methods</h4>
        <dl>
            {% for method in class.methods %}
            <dt><code>{{ method.signature }}</code></dt>
            <dd>{{ method.description }}</dd>
            {% endfor %}
        </dl>
        {% endif %}
    </article>
    {% endfor %}
</section>
{% endfor %}
